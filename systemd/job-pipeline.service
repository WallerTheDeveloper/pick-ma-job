[Unit]
Description=pick-ma-job FastAPI backend
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/pick-ma-job
EnvironmentFile=/opt/pick-ma-job/.env
ExecStart=/opt/pick-ma-job/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
